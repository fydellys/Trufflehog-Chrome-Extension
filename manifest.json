{
  "name": "Trufflehog",
  "version": "0.1.0",
  "manifest_version": 3,
  "minimum_chrome_version": "102",
  "description": "Sniffing out credentials",
  "homepage_url": "https://trufflesecurity.com",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Trufflehog",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["inject.js"]
    }
  ]
}
